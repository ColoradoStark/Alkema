12,569],[59,-18,548,665],[59,-18,932,1049],[60,-13,988,1145],[59,-18,1124,1241],[60,-13,1180,1337],[59,-18,1316,1433],[60,-13,1372,1529],[59,-18,1508,1625],[61,750,249,339],[59,1187,241,358],[59,1450,247,364],[61,558,338,428],[61,1045,1458,1548],[59,586,1470,1587],[59,483,1111,1228],[62,1380,348,428],[62,1079,1212,1292],[62,74,1148,1228],[62,1476,1494,1574]],"arrive":[96,832],"exits":[{"rect":[0,768,64,128],"to":null,"dir":"left"},{"rect":[786,768,28,18],"to":"gulls_rest-alehouse","at":[272,396],"dir":"up","door":true},{"rect":[306,768,28,18],"to":"gulls_rest-fisherman","at":[336,492],"dir":"up","door":true},{"rect":[1122,768,28,18],"to":"gulls_rest-netloft","at":[304,492],"dir":"up","door":true},{"rect":[1362,768,28,18],"to":"gulls_rest-house1","at":[336,492],"dir":"up","door":true},{"rect":[226,1152,28,18],"to":"gulls_rest-house2","at":[336,492],"dir":"up","door":true},{"rect":[674,1152,28,18],"to":"gulls_rest-house3","at":[336,492],"dir":"up","door":true},{"rect":[866,1184,28,18],"to":"gulls_rest-smokehouse","at":[240,332],"dir":"up","door":true},{"rect":[1490,1504,28,18],"to":"gulls_rest-boatwright","at":[304,492],"dir":"up","door":true},{"rect":[338,1504,28,18],"to":"gulls_rest-house4","at":[336,492],"dir":"up","door":true},{"rect":[914,1536,28,18],"to":"gulls_rest-house5","at":[336,492],"dir":"up","door":true},{"rect":[130,768,28,18],"to":"gulls_rest-healer","at":[272,364],"dir":"up","door":true}],"indoors":false,"folk":[{"id":"mags","role":"Harbourmaster","post":[1715.2,716.8],"facing":"down","says":["Welcome to Gull's Rest. Tie up where you like, pay me before you leave.","Don't row north past the point. That's Morvath over the water, and nothing good sails out of it."],"night":"away","via":"gulls_rest-alehouse"},{"id":"jory","role":"Fisherman","post":[2028.8,595.2],"facing":"right","chore":"fish","says":["Mackerel run past the end of the dock every morning. Every morning but this one.","My boat's the one with the patched side. Patched it three times. She's more patch than boat."],"night":"away","via":"gulls_rest-alehouse"},{"id":"kofi","role":"Fisherman","post":[2060.8,1107.2],"facing":"right","chore":"fish","says":["Came here off a trader from the far south, twenty years back. Never got back on.","The fish up here are slower than at home. Lazier. Easier to catch, if I'm honest."],"night":"away","via":"gulls_rest-alehouse"},{"id":"nell","role":"Fisherwoman","post":[1779.2,883.2],"facing":"right","chore":"fish","says":["I fish from the beach. No boat, no harbour dues. Mags hates it.","Bass, when the tide's right. Weed, when it isn't."],"night":"away","via":"gulls_rest-alehouse"},{"id":"perran","role":"Net-mender","post":[614.4,761.6],"facing":"down","chore":"sit","says":["Fifty years at sea, ten mending nets on this bench. The bench is kinder.","Gulls? Rest? The gulls never rest. Ask anyone who's tried to sleep past dawn here."],"night":"away","via":"gulls_rest-alehouse"},{"id":"tamsin","role":"Fishwife","post":[1363.2,1043.2],"facing":"down","says":["Herring, mackerel, fresh cod! And for you, sweetheart, a wink, free of charge.","Crabs are a copper each. Kisses cost more. Mind you, I'd haggle."],"night_says":["The stall's shut, the gulls are asleep, and I smell of the sea. Still want to stay?","I'll tell you a fisherman's secret. The best catches come after dark."],"night":"away","via":"gulls_rest-house1"},{"id":"dara","role":"Fishmonger","post":[1529.6,1043.2],"facing":"down","says":["Mussels and oysters. Tamsin sells fish, I sell what lives in shells. We don't talk about crabs.","My mother sailed with the spice fleet. I got the tongue for selling and none for sailing."],"night":"away","via":"gulls_rest-alehouse"},{"id":"wil","role":"Errand lad","wander":[144.0,816.0,1648.0,880.0],"says":["Fish to the alehouse, empty baskets back. Mum says I'm the fastest legs in the harbour.","Have you seen a sea serpent? Old Perran has. Twice. Once on a Tuesday."],"night":"away","via":"gulls_rest-house3"},{"id":"isolde","role":"Villager","wander":[976.0,880.0,1616.0,1264.0],"says":"Market day every day, if you live by the sea. The fish don't wait for Sunday.","night":"away","via":"gulls_rest-house5"},{"id":"cador","role":"Gardener","wander":[176.0,368.0,368.0,464.0],"chore":"water","says":"Jory catches, I grow. Salt in the soil, but leeks don't mind it.","night":"away","via":"gulls_rest-house2"},{"id":"femi","role":"Bait-digger","wander":[1648.0,1296.0,1712.0,1616.0],"chore":"dig","says":["Lugworms, under the sand, if you dig fast enough. Want to stay and watch me?","Dad says the fish here are lazy. I say you're the best thing the tide's brought in."],"night_says":["No digging tonight. My hands are clean, and they're all yours.","Walk me down to the beach later? I know a quiet spot in the moonlight."],"night":"away","via":"gulls_rest-house4"},{"id":"brannoc","role":"Deckhand","post":[1804.8,1177.6],"facing":"right","says":["Unload the boat, load the cart, unload the cart. My back says it's a long day.","Duskmere's west along the coast. Folk come from there to buy salt fish. Pale, quiet folk."],"night":"away","via":"gulls_rest-alehouse"},{"id":"gwen","role":"Gleaner","wander":[496.0,976.0,1168.0,1424.0],"says":["Driftwood, seaweed, and once a gold ring. Today the sea brought me you.","Help me fill my basket, and I'll share whatever treasure we find."],"night_says":["The tide's coming in, and I've nowhere to be tonight. Have you?","I found a pearl once. You're rarer, I think."],"night":"away","via":"gulls_rest-house3"},{"id":"aldo","role":"Boatwright","post":[1478.4,1561.6],"facing":"down","says":["Every boat in this harbour went down my slipway. And came back up it, mostly.","Oak from inland, pitch from the south, and a prayer to whatever's listening out there."],"night":"away","via":"gulls_rest-alehouse"},{"id":"senna","role":"Traveller","post":[172.8,915.2],"facing":"right","says":["Waiting on a boat south. Mags says three days. Mags said three days last week.","Funny place. Folk from every shore, and every one of them thinks they're the local."],"night":"away","via":"gulls_rest-alehouse"},{"id":"morwen","role":"Smoker","post":[998.4,755.2],"facing":"down","chore":"sit","says":["Oak chips and patience. Smoked fish keeps all winter. Fresh keeps till Thursday.","Dara's my cousin. We don't look it. Her side went south, mine stayed put."]}],"facing":"right","breaks":[{"thing":93,"kind":"crate","solid":[[1292,986,1319,1004]]},{"thing":94,"kind":"crate","solid":[[1336,993,1364,1011]]},{"thing":95,"kind":"crate","solid":[[1381,986,1409,1004]]},{"thing":96,"kind":"crate","solid":[[1464,986,1492,1004]]},{"thing":97,"kind":"crate","solid":[[1509,993,1536,1011]]},{"thing":98,"kind":"crate","solid":[[1554,986,1581,1004]]},{"thing":99,"kind":"barrel","solid":[[1277,1085,1320,1107]]},{"thing":105,"kind":"crate","solid":[[1603,637,1660,659]]},{"thing":106,"kind":"barrel","solid":[[1958,1104,1983,1126]]},{"thing":113,"kind":"barrel","solid":[[1597,464,1640,486]]},{"thing":114,"kind":"crate","solid":[[1584,1181,1641,1203]]},{"thing":117,"kind":"barrel","solid":[[934,701,959,723]]},{"thing":125,"kind":"crate","solid":[[402,730,429,748]]}],"shut":[{"rect":[1372,1504,40,18],"says":"The big doors are shut fast."}],"lights":[[720,669,"window"],[816,669,"window"],[896,669,"window"],[720,728,"window"],[880,728,"window"],[748,784,"torch"],[851,784,"torch"],[1673,1312,"campfire"],[400,712,"window"],[1088,712,"window"],[1184,712,"window"],[1456,712,"window"],[192,1096,"window"],[288,1096,"window"],[624,1096,"window"],[880,1075,"window"],[390,1448,"window"],[848,1480,"window"],[192,712,"window"]]}