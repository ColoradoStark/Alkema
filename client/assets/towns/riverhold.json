,[38,-12,869,1024],[39,-18,1003,1120],[38,-15,1061,1216],[38,1837,21,176],[38,1837,117,272],[38,1837,213,368],[38,1837,309,464],[38,1837,405,560],[38,1837,501,656],[38,1837,597,752],[38,1837,693,848],[38,1837,789,944],[38,1837,885,1040],[38,1837,981,1136],[38,1837,1077,1232],[39,1610,395,512],[40,1794,486,576],[40,1650,726,816],[40,1826,742,832],[40,1810,1158,1248],[40,1621,1062,1152],[39,1366,267,384],[40,1394,982,1072],[39,928,-79,38],[39,1024,-53,64],[39,291,1140,1257],[39,118,1140,1257],[40,1333,582,672],[39,1040,891,1008],[39,26,190,307],[39,227,1105,1222],[41,439,777,857],[41,1361,515,595]],"gate":[0,672,64,800],"arrive":[96,736],"folk":[{"id":"innkeeper","role":"Innkeeper","post":[761.6,469.12],"facing":"down","says":"Welcome to the Ferryman's Rest! Dry beds, and ale that isn't."},{"id":"smith","role":"Weaponsmith","post":[409.6,501.12],"facing":"down","says":"Blades sharpened, axes balanced. Mind the anvil, it bites."},{"id":"armourer","role":"Armourer","post":[118.4,597.12],"facing":"down","says":"Mail, plate, a good stout shield. Nothing that rusts."},{"id":"grocer","role":"Grocer","post":[697.6,1205.12],"facing":"down","says":"Bread, cheese, salt fish for the road. Fair weights here."},{"id":"herbalist","role":"Herbalist","post":[985.6,1205.12],"facing":"down","says":"Feverfew, mandrake, a little nightshade. For the gardens, of course."},{"id":"healer","role":"Healer","post":[1222.4,533.12],"facing":"down","says":"Come in out of the sun. The sick and the hurt are welcome here."},{"id":"gatewarden","role":"Gate warden","post":[102.4,652.8],"facing":"down","says":"Gate stays open till dusk. Keep your blade sheathed in town."},{"id":"stablehand","role":"Stablehand","post":[364.8,1013.12],"facing":"down","says":"Horses? Not for sale. The bridge at Stonebridge washed out, so they're all spoken for."},{"id":"ferryman","role":"Ferryman","post":[784.0,1427.2],"facing":"down","says":"No crossing today. River's high, and something's been knocking at the hull."},{"id":"lurker","role":"Hooded stranger","post":[524.8,236.8],"facing":"left","says":"You didn't see me. I didn't see you. That's how it works back here."},{"id":"gravedigger","role":"Gravedigger","post":[1235.2,214.4],"facing":"up","says":"Seven graves since spring. Most from up the river. Nobody says why."},{"id":"hermit","role":"Hermit","post":[1788.8,405.12],"facing":"down","says":"Few cross the creek to see me. Fewer cross back with the same questions."},{"id":"fisher","role":"Fisherwoman","post":[1776.0,1235.2],"facing":"down","says":"The pike are biting. So's something bigger, down by the old mill."},{"id":"noble","role":"Lady of Riverhold","post":[947.2,556.8],"facing":"down","says":"Riverhold pays its dues to Castle Dunmere, and Dunmere forgets us all the same."},{"id":"wanderer1","role":"Townsman","wander":[592.0,560.0,1072.0,912.0]},{"id":"wanderer2","role":"Townswoman","wander":[592.0,560.0,1072.0,912.0]},{"id":"wanderer3","role":"Pilgrim","wander":[96,704,1408,784.0]},{"id":"wanderer4","role":"Washerwoman","wander":[544,1168.0,1280,1232.0]},{"id":"wanderer5","role":"Guard","wander":[592.0,560.0,1408,784.0]}]}