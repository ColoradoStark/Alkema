,"wander":[288,592.0,528.0,752.0],"says":"North road's gone quiet. Too quiet, the captain says. I say quiet's quiet.","lamp":"carried"},{"id":"stablehand","role":"Stablehand","post":[403.2,595.2],"facing":"down","night":"away","says":"The Duke's greys. Finest horses south of the mountains. Don't touch the white one, she bites.","via":"dunmere-barracks"},{"id":"gardener","role":"Gardener","night":"away","wander":[304.0,972.8,464.0,1036.8],"chore":"hoe","says":["Cabbages for the Duke's table. He won't eat them, but his guard will.","Forty years I've dug this bed. The walls keep the wind off and the wolves out."],"via":"dunmere-barracks"},{"id":"maid","role":"Maidservant","night":"away","wander":[576,656.0,976.0,976.0],"says":"Linens to the chambers, ale to the barracks, and never a moment to sit.","via":"dunmere-keep"},{"id":"page","role":"Page","night":"away","wander":[560.0,656.0,992,1056],"says":"I carry the Duke's letters! Well. I carry them to the man who carries them.","via":"dunmere-keep"},{"id":"pilgrim","role":"Pilgrim","night":"away","wander":[384,883.2,576,928],"says":"I walked from Saltmere to be blessed in the Duke's chapel. My feet are less blessed.","via":"dunmere-chapel"},{"id":"merchant","role":"Merchant","night":"away","post":[883.2,780.8],"facing":"down","says":"Came to sell the Duke iron. He bought it, too. Paid in coin, not promises, unlike Riverhold.","via":"dunmere-keep"},{"id":"knight","role":"Knight","night":"away","wander":[1056,880.0,1264.0,992],"says":"Sworn to Dunmere, not to any king. When the dark comes south, we ride. Not before.","via":"dunmere-barracks"}],"facing":"up","breaks":[{"thing":21,"kind":"barrel","solid":[[1264,554,1308,576]]},{"thing":22,"kind":"crate","solid":[[1193,944,1251,966]]}],"lights":[[684,1305,"torch"],[851,1305,"torch"],[691,1052,"torch"],[844,1052,"torch"],[576,464.0,"window"],[768,464.0,"window"],[960,464.0,"window"],[713,630,"torch"],[822,630,"torch"],[336,808,"window"],[496,808,"window"],[1040,733,"window"],[