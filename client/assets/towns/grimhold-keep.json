","at":[768,632],"dir":"down","door":true},{"rect":[552,160,48,20],"to":"grimhold-chambers","at":[448,364],"dir":"up","stair":"up"},{"rect":[1464,1188,48,40],"to":"grimhold-cells","at":[1248,454],"dir":"down","stair":"down"}],"indoors":true,"folk":[{"id":"lord","role":"Lord of Grimhold","post":[816.0,268.8],"facing":"down","says":["So. Dunmere's little errand-runner comes to Grimhold.","Kneel, or don't. The mountain doesn't care either way, and neither do I.","The north is waking. When it comes south, I mean to stand at its side, not under its feet.","Tell your Duke that neutrality is only a slower way to lose."]},{"id":"guard11","role":"Black guard","post":[736,275.2],"facing":"down","says":"One more step and you'll be measuring the floor."},{"id":"guard12","role":"Black guard","post":[896,275.2],"facing":"down","says":"His lordship isn't receiving. He's taking."},{"id":"chamberlain","role":"Chamberlain","post":[979.2,262.4],"facing":"left","says":"His lordship receives no petitions. He receives tribute. Have you brought any?"},{"id":"jester","role":"Jester","wander":[729.6,307.2,902.4,428.8],"says":["Laugh! The last one who didn't is down in the cells. Well. His bones are.","What's black and red and smiles at funerals? Me! Ha! Ha. Please laugh."]},{"id":"guard13","role":"Door guard","post":[748.8,1299.2],"facing":"up","says":"State your name. Then forget it. Grimhold will give you a new one."},{"id":"guard14","role":"Door guard","post":[883.2,1299.2],"facing":"up","says":"Throne room ahead. The study on the left, if you're fond of the dead. Cells below, if you're not careful."},{"id":"guard17","role":"Treasury guard","post":[1273.6,582.4],"facing":"down","says":"Lord Varek's treasury. Look at it again and lose the eye."},{"id":"guard18","role":"Treasury guard","post":[1414.4,582.4],"facing":"down","says":"Tribute from six villages in there. None of it given willingly."},{"id":"guard19","role":"Treasury guard","post":[1299.2,339.2],"facing":"down","says":"Every coin counted. Every thief counted, too. In the graveyard."},{"id":"guard20","role":"Treasury guard","post":[1420.8,339.2],"facing":"down","says":"Gold for the north's coming. His lordship plans ahead."},{"id":"necromancer","role":"Necromancer","post":[272.0,313.6],"facing":"up","says":["The dead are so much more reliable than the living. They never ask for wages.","The skeletons in the cells are mine. Don't feed them. They don't eat, it only encourages them."]},{"id":"cook","role":"Cook","post":[320.0,1120.0],"facing":"down","says":"Stew. It's always stew. Don't ask what's in it, and you'll eat."},{"id":"captain","role":"Mercenary captain","post":[108.8,716.8],"facing":"right","says":"Lord Varek pays in gold and promises. The gold I keep. The promises I sell on."},{"id":"maid","role":"Maidservant","says":"Eyes down, mouth shut, and you live long in Grimhold. Mostly.","post":[816.0,720.0],"facing":"down","day":"away","via":"grimhold"}],"breaks":[{"thing":55,"kind":"barrel","solid":[[78,1305,101,1331]]},{"thing":56,"kind":"barrel","solid":[[106,1305,162,1331]]},{"thing":58,"kind":"barrel","solid":[[432,1305,488,1331]]},{"thing":64,"kind":"barrel","solid":[[1495,556,1551,582]]},{"thing":85,"kind":"barrel","solid":[[1168,1305,1224,1331]]}],"lights":[[554,844,"hearth"],[1085,844,"hearth"],[554,1285,"hearth"],[1085,1285,"hearth"],[720,197,"hearth"],[919,197,"hearth"],[554,428,"hearth"],[1085,428,"hearth"],[692,645,"hearth"],[948,645,"hearth"],[192,149,"candle"],[352,149,"candle"],[369,573,"hearth"],[93,812,"hearth"],[458,812,"hearth"],[369,1021,"hearth"],[96,1008,"stove"],[1181,332,"hearth"],[1546,332,"hearth"]]}