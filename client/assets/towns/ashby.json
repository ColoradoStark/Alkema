,-18,99],[82,898,-70,87],[81,987,-29,88],[82,1071,-74,83],[81,1156,-31,86],[82,1270,-68,89],[81,1353,-32,85],[82,1456,-60,97],[81,1564,-24,93],[82,1649,-63,94],[81,1743,-25,92],[82,1836,-72,85],[81,1943,-19,98],[82,2025,-64,93],[82,598,1558,1715],[81,687,1598,1715],[82,787,1558,1715],[81,875,1598,1715],[82,991,1558,1715],[81,1080,1598,1715],[82,1178,1558,1715],[81,1271,1598,1715],[82,1353,1558,1715],[81,1452,1598,1715],[82,1549,1558,1715],[81,1654,1598,1715],[82,1736,1558,1715],[81,1831,1598,1715],[82,1934,1558,1715],[81,2035,1598,1715],[82,2104,28,185],[81,2099,164,281],[82,2104,220,377],[81,2099,356,473],[82,2104,412,569],[81,2099,548,665],[81,2099,932,1049],[82,2104,988,1145],[81,2099,1124,1241],[82,2104,1180,1337],[81,2099,1316,1433],[82,2104,1372,1529],[81,2099,1508,1625],[81,342,-15,102],[81,739,17,134],[81,1539,23,140],[81,2013,11,128],[81,1635,1547,1664],[81,822,1534,1651],[81,1059,638,755],[83,324,1590,1670],[83,2020,1584,1664],[83,2065,380,460],[83,516,1571,1651]],"arrive":[2048,832],"exits":[{"rect":[2112,768,64,128],"to":null,"dir":"right"},{"rect":[418,832,28,18],"to":"ashby-netmaker","at":[304,492],"dir":"up","door":true},{"rect":[594,800,28,18],"to":"ashby-fisherman","at":[336,492],"dir":"up","door":true},{"rect":[962,800,28,18],"to":"ashby-farmhouse","at":[368,492],"dir":"up","door":true},{"rect":[1186,800,28,18],"to":"ashby-house1","at":[304,492],"dir":"up","door":true},{"rect":[1362,800,28,18],"to":"ashby-house2","at":[336,492],"dir":"up","door":true},{"rect":[1698,832,28,18],"to":"ashby-house3","at":[304,492],"dir":"up","door":true},{"rect":[450,1600,28,18],"to":"ashby-hut","at":[304,492],"dir":"up","door":true},{"rect":[1938,832,28,18],"to":"ashby-healer","at":[272,364],"dir":"up","door":true}],"indoors":false,"folk":[{"id":"finn","role":"Fisherman","post":[108.8,864.0],"facing":"down","chore":"sit","says":["Mackerel in the morning, barley in the afternoon. That's Ashby.","See out there, past the point? The big island. Nobody fishes near it. Nobody comes back the same."],"night":"away","via":"ashby-house1"},{"id":"gerda","role":"Fisherman's wife","post":[294.4,1094.4],"facing":"down","says":["Nets don't mend themselves. Neither does Finn, and he's twice the work.","I'm from Seacombe, down the coast. You can tell, can't you? Everyone here's fair as straw."],"night":"away","via":"ashby-house2"},{"id":"eric","role":"Farmer","wander":[944.0,976.0,1136.0,1136.0],"chore":"water","says":["Salt on the wind. Carrots don't mind it. Lettuce did, so no more lettuce.","Those four fields up top fed the whole coast through the last bad winter."],"night":"away","via":"ashby-house3"},{"id":"sigrid","role":"Farmer's wife","wander":[1328.0,976.0,1552.0,1136.0],"chore":"water","says":"The pumpkins want more water than the cows. And complain less.","night":"away","via":"ashby-house2"},{"id":"olaf","role":"Field hand","wander":[944.0,1296.0,1136.0,1488.0],"chore":"hoe","says":["Potatoes. Leeks. Potatoes. Leeks. I dream in rows.","Mind the cliff at the top of the grain. It's a long way down to the rocks."],"night":"away","via":"ashby-farmhouse"},{"id":"anders","role":"Field hand","wander":[1328.0,1296.0,1552.0,1488.0],"chore":"dig","says":"Corn grows tall by the sea. Something in the fog. Or in the fish heads we dig in.","night":"away","via":"ashby-house3"},{"id":"hilde","role":"Gardener","wander":[1840.0,550.4,2000.0,595.2],"chore":"water","says":["Mind the leeks. If you must step on something, step on my heart instead.","Onions make me cry. You make me smile. I know which I'd rather."],"night_says":["The garden's asleep, and so is everyone else. Shall we keep each other awake?","No flowers to give you at this hour. Will a smile do instead?"],"night":"away","via":"ashby-house1"},{"id":"rolf","role":"Crofter","wander":[1712.0,1296.0,2000.0,1488.0],"chore":"hoe","says":["Lifted the lot last week. Turning it over now before the autumn gales.","Ashby? Ash trees, once. All gone for boats. Now it's just a name."],"night":"away","via":"ashby-hut"},{"id":"ivo","role":"Crofter","wander":[1712.0,1296.0,2000.0,1488.0],"chore":"dig","says":"Dad hoes, I dig. Dad talks, I dig. Dad sits, I dig.","night":"away","via":"ashby-fisherman"},{"id":"lars","role":"Farm lad","wander":[400.0,819.2,2000.0,883.2],"says":["Fish up to the farm, potatoes down to the boats. I'm what Ashby runs on.","Is Riverhold really bigger than all of Ashby? Twice as big? Ten times?"],"night":"away","via":"ashby-netmaker"},{"id":"britt","role":"Gleaner","wander":[400.0,467.2,2000.0,499.2],"says":["Whatever the reapers leave, I pick up. Today, I think the field left me you.","Careful, you'll make me drop my gleanings, staring like that."],"night_says":["My basket's put away for the night. My hands are free, you know.","Tell me I'm prettier than a field of wheat. Go on, I'll wait."],"night":"away","via":"ashby-house1"},{"id":"old_ulf","role":"Village elder","post":[812.8,1164.8],"facing":"down","chore":"sit","says":["Seventy winters on this coast. The sea's taken four boats and given back two. Fair trade, some would say.","Seacombe's down the coast to the south. Good folk. Can't tell a herring from a haddock."],"night":"away","via":"ashby-farmhouse"},{"id":"ebba","role":"Dairymaid","post":[678.4,1350.4],"facing":"down","chore":"sit","says":["Off my feet for a moment, and look who comes by. The goats can wait. They always can.","Fresh milk, if you're thirsty. Or you could just sit with me a while."],"night_says":["No goats, no pails, and nobody watching. Just you and me.","I saved the warm spot by the fire. It's yours, if you sit close."],"night":"away","via":"ashby-hut"},{"id":"tobin","role":"Barn hand","post":[595.2,1241.6],"facing":"down","says":["Came over from Fernwick to work the barn. Only dark head in the village. They call me the Crow.","Hay's in. Now we wait for the gales and hope the roof holds."],"night":"away","via":"ashby-fisherman"},{"id":"freya","role":"Villager","wander":[432.0,883.2,880.0,1200.0],"says":["Water from the well, not the sea, unless you fancy a bellyache.","Olaf and Anders are my boys. Olaf dreams of rows. Anders dreams of the sea."],"night":"away","via":"ashby-netmaker"}],"facing":"left","breaks":[{"thing":409,"kind":"crate","solid":[[272,701,329,723]]},{"thing":410,"kind":"barrel","solid":[[262,726,287,748]]},{"thing":411,"kind":"crate","solid":[[246,976,304,998]]},{"thing":414,"kind":"barrel","solid":[[260,1302,303,1324]]},{"thing":419,"kind":"crate","solid":[[767,1076,794,1094]]},{"thing":420,"kind":"crate","solid":[[869,1082,896,1100]]}],"shut":[{"rect":[508,1152,40,18],"says":"The big doors are shut fast."},{"rect":[636,1152,40,18],"says":"The big doors are shut fast."}],"lights":[[432,723,"window"],[688,744,"window"],[912,701,"window"],[992,701,"window"],[1056,701,"window"],[912,760,"window"],[1040,760,"window"],[1228,744,"window"],[1456,744,"window"],[1712,723,"window"],[1894,776,"window"],[2009,776,"window"]]}