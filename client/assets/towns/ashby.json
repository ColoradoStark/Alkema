71,1408,1314,1408],[72,1232,1538,1600],[73,1594,1171,1203],[74,791,467,524],[75,1126,402,428],[76,1578,473,537],[77,2019,1012,1088],[65,1762,1548,1580],[65,1922,1555,1587],[78,1043,499,563],[72,1450,501,563],[79,1734,863,908],[80,589,-31,86],[81,703,-61,96],[80,773,-16,101],[81,887,-70,87],[80,981,-33,84],[81,1087,-73,84],[80,1158,-22,95],[81,1275,-66,91],[80,1355,-30,87],[81,1462,-63,94],[80,1553,-26,91],[81,1648,-66,91],[80,1734,-30,87],[81,1853,-62,95],[80,1945,-18,99],[81,2027,-58,99],[81,599,1558,1715],[80,691,1598,1715],[81,791,1558,1715],[80,882,1598,1715],[81,986,1558,1715],[80,1071,1598,1715],[81,1168,1558,1715],[80,1268,1598,1715],[81,1361,1558,1715],[80,1456,1598,1715],[81,1548,1558,1715],[80,1653,1598,1715],[81,1761,1558,1715],[80,1849,1598,1715],[81,1953,1558,1715],[80,2043,1598,1715],[81,2104,28,185],[80,2099,164,281],[81,2104,220,377],[80,2099,356,473],[81,2104,412,569],[80,2099,548,665],[80,2099,932,1049],[81,2104,988,1145],[80,2099,1124,1241],[81,2104,1180,1337],[80,2099,1316,1433],[81,2104,1372,1529],[80,2099,1508,1625],[80,342,-15,102],[80,739,17,134],[80,1539,23,140],[80,2013,11,128],[80,1635,1547,1664],[80,822,1534,1651],[80,1059,638,755],[82,324,1590,1670],[82,2020,1584,1664],[82,2065,380,460],[82,516,1571,1651]],"arrive":[2048,832],"exits":[{"rect":[2112,768,64,128],"to":null,"dir":"right"},{"rect":[418,832,28,18],"to":"ashby-netmaker","at":[208,332],"dir":"up"},{"rect":[594,800,28,18],"to":"ashby-fisherman","at":[240,332],"dir":"up"},{"rect":[962,800,28,18],"to":"ashby-farmhouse","at":[208,332],"dir":"up"},{"rect":[450,1600,28,18],"to":"ashby-hut","at":[208,332],"dir":"up"}],"indoors":false,"folk":[{"id":"finn","role":"Fisherman","post":[108.8,864.0],"facing":"down","chore":"sit","says":["Mackerel in the morning, barley in the afternoon. That's Ashby.","See out there, past the point? The big island. Nobody fishes near it. Nobody comes back the same."]},{"id":"gerda","role":"Fisherman's wife","post":[294.4,1094.4],"facing":"down","says":["Nets don't mend themselves. Neither does Finn, and he's twice the work.","I'm from inland, Millbrook way. You can tell, can't you? Everyone here's fair as straw."]},{"id":"eric","role":"Farmer","wander":[944.0,976.0,1136.0,1136.0],"chore":"water","says":["Salt on the wind. Carrots don't mind it. Lettuce did, so no more lettuce.","Those four fields up top fed the whole coast through the last bad winter."]},{"id":"sigrid","role":"Farmer's wife","wander":[1328.0,976.0,1552.0,1136.0],"chore":"water","says":"The pumpkins want more water than the cows. And complain less."},{"id":"olaf","role":"Field hand","wander":[944.0,1296.0,1136.0,1488.0],"chore":"hoe","says":["Potatoes. Leeks. Potatoes. Leeks. I dream in rows.","Mind the cliff at the top of the grain. It's a long way down to the rocks."]},{"id":"anders","role":"Field hand","wander":[1328.0,1296.0,1552.0,1488.0],"chore":"dig","says":"Corn grows tall by the sea. Something in the fog. Or in the fish heads we dig in."},{"id":"hilde","role":"Gardener","wander":[1840.0,624.0,2000.0,720.0],"chore":"water","says":"This bit's mine. Onions and leeks for the pot, and nobody's boots in it."},{"id":"rolf","role":"Crofter","wander":[1712.0,1296.0,2000.0,1488.0],"chore":"hoe","says":["Lifted the lot last week. Turning it over now before the autumn gales.","Ashby? Ash trees, once. All gone for boats. Now it's just a name."]},{"id":"ivo","role":"Crofter","wander":[1712.0,1296.0,2000.0,1488.0],"chore":"dig","says":"Dad hoes, I dig. Dad talks, I dig. Dad sits, I dig."},{"id":"lars","role":"Farm lad","wander":[400.0,819.2,2000.0,883.2],"says":["Fish up to the farm, potatoes down to the boats. I'm what Ashby runs on.","Is Riverhold really bigger than all of Ashby? Twice as big? Ten times?"]},{"id":"britt","role":"Gleaner","wander":[400.0,467.2,2000.0,499.2],"says":"Whatever the reapers leave, I pick up. Enough for a loaf a day, some days two."},{"id":"old_ulf","role":"Village elder","post":[812.8,1164.8],"facing":"down","chore":"sit","says":["Seventy winters on this coast. The sea's taken four boats and given back two. Fair trade, some would say.","Millbrook's down the coast to the south. Good folk. Can't tell a herring from a haddock."]},{"id":"ebba","role":"Dairymaid","post":[678.4,1350.4],"facing":"down","chore":"sit","says":"Off my feet for a moment. The goats can wait. The goats can always wait."},{"id":"tobin","role":"Barn hand","post":[595.2,1241.6],"facing":"down","says":["Came over from Fernwick to work the barn. Only dark head in the village. They call me the Crow.","Hay's in. Now we wait for the gales and hope the roof holds."]},{"id":"freya","role":"Villager","wander":[432.0,883.2,880.0,1200.0],"says":["Water from the well, not the sea, unless you fancy a bellyache.","Olaf and Anders are my boys. Olaf dreams of rows. Anders dreams of the sea."]}],"facing":"left"}