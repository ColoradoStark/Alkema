,966],[26,1251,904,966],[31,1404,936,960],[30,1424,921,953],[31,1174,1096,1120],[21,1166,1287,1331]],"arrive":[816,1324],"exits":[{"rect":[802,1328,28,16],"to":"dunmere","at":[768,632],"dir":"down"},{"rect":[552,160,48,20],"to":"dunmere-chambers","at":[448,364],"dir":"up"},{"rect":[1464,1188,48,40],"to":"dunmere-cells","at":[1248,454],"dir":"down"}],"indoors":true,"folk":[{"id":"duke","role":"Duke of Dunmere","post":[816.0,268.8],"facing":"down","says":["Welcome to Dunmere, traveller. Few come to us who aren't asking for something.","We keep to ourselves here. The realm's quarrels are the realm's; my walls are mine.","But I am not blind. Something stirs in the north, past Castle Grimhold, and the roads grow dangerous.","If you mean to set it right, Dunmere's gate is open to you, and my healer's hands are yours."]},{"id":"guard11","role":"Royal guard","post":[736,275.2],"facing":"down","says":"The Duke is not to be crowded. That means you."},{"id":"guard12","role":"Royal guard","post":[896,275.2],"facing":"down","says":"Stand where I can see you, and we'll get along."},{"id":"steward","role":"Steward","post":[979.2,262.4],"facing":"left","says":"The Duke's day is full. Though for one who rides against the north, it can be made less full."},{"id":"courtier1","role":"Courtier","wander":[560.0,320,656.0,512],"says":"The Duke listens to everyone and agrees with no one. It's quite maddening."},{"id":"courtier2","role":"Courtier","wander":[976.0,320,1072.0,512],"says":"Grimhold sent an envoy last spring. He left without his horse. Nobody says why."},{"id":"jester","role":"Jester","wander":[729.6,307.2,902.4,428.8],"says":["A riddle for you! What has a moat, forty spears, and no opinion? Dunmere!","The Duke laughs at all my jokes. Well. He did once. In the spring, I think."]},{"id":"guard13","role":"Door guard","post":[748.8,1299.2],"facing":"up","says":"Petitioners wait their turn. You're the turn, it seems."},{"id":"guard14","role":"Door guard","post":[883.2,1299.2],"facing":"up","says":"The Duke's through there. Kitchens and the feast hall west, the guardroom and the armoury east."},{"id":"guard17","role":"Treasury guard","post":[1273.6,582.4],"facing":"down","says":"The Duke's treasury. Nobody goes in that the Duke didn't send. Did the Duke send you?"},{"id":"guard18","role":"Treasury guard","post":[1414.4,582.4],"facing":"down","says":"Look all you like. Touch, and you'll be looking at the cells downstairs."},{"id":"guard19","role":"Treasury guard","post":[1299.2,339.2],"facing":"down","says":"Every coin counted twice a day. Every chest locked twice over."},{"id":"guard20","role":"Treasury guard","post":[1420.8,339.2],"facing":"down","says":"Dunmere's gold keeps the north road safe. Some of it. When the Duke remembers."},{"id":"cook","role":"Cook","post":[320.0,1120.0],"facing":"down","says":"Venison tonight, and the Duke's pie if he behaves. Out from under my feet now."},{"id":"servant","role":"Servant","wander":[112.0,793.6,432.0,844.8],"says":"Forty for supper and the Duke wants the good plates. There are thirty good plates."},{"id":"knight2","role":"Knight","post":[108.8,716.8],"facing":"right","says":"A feast for Midsummer, the Duke says. Half the knights at this table won't see the next."},{"id":"magister","role":"Court mage","post":[272.0,313.6],"facing":"up","says":["The north's cold isn't weather. I've read of it before, in older books than these.","When you find what's waking up there, come back and tell me its name."]},{"id":"scribe","role":"Scribe","post":[403.2,243.2],"facing":"down","says":"Every tithe Riverhold ever paid, in this book. Every one they didn't, in that one. It's bigger."},{"id":"maid","role":"Maidservant","says":"Linens to the chambers, ale to the barracks, and never a moment to sit.","post":[816.0,720.0],"facing":"down","day":"away","via":"dunmere"},{"id":"page","role":"Page","says":"I carry the Duke's letters! Well. I carry them to the man who carries them.","post":[816.0,624.0],"facing":"down","day":"away","via":"dunmere"},{"id":"merchant","role":"Merchant","says":"Came to sell the Duke iron. He bought it, too. Paid in coin, not promises, unlike Riverhold.","post":[768.0,672.0],"facing":"down","day":"away","via":"dunmere"}],"breaks":[{"thing":56,"solid":[[78,1305,101,1331]]},{"thing":57,"solid":[[106,1305,162,1331]]},{"thing":59,"solid":[[432,1305,488,1331]]},{"thing":66,"solid":[[1495,556,1551,582]]},{"thing":90,"solid":[[1168,1305,1224,1331]]}],"lights":[[608,1276,"candle"],[1024,1276,"candle"],[720,197,"hearth"],[919,197,"hearth"],[550,412,"candle"],[1081,412,"candle"],[192,149,"candle"],[352,149,"candle"],[369,573,"hearth"],[89,796,"candle"],[454,796,"candle"],[369,1021,"hearth"],[96,1008,"stove"],[128,1008,"stove"],[1466,500,"lantern"],[1177,316,"candle"],[1542,316,"candle"]]}