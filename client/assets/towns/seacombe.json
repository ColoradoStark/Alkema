rmhouse","at":[368,492],"dir":"up","door":true},{"rect":[834,448,28,18],"to":"seacombe-cottage","at":[304,492],"dir":"up","door":true},{"rect":[1010,416,28,18],"to":"seacombe-house1","at":[304,492],"dir":"up","door":true},{"rect":[1570,320,28,18],"to":"seacombe-croft","at":[304,492],"dir":"up","door":true}],"indoors":false,"folk":[{"id":"tom","role":"Farmer","wander":[464.0,848.0,656.0,976.0],"chore":"water","says":["Carrots want a good soak before the sun's up. Beets too.","Every bed you see here my grandfather dug. I just keep them wet."],"night":"away","via":"seacombe-house1"},{"id":"maud","role":"Farmer's wife","wander":[848.0,848.0,1104.0,976.0],"chore":"water","says":["The potatoes are only just up. Mind where you put your feet.","If you're bound for Riverhold, they pay better for our onions than the grocer lets on."],"night":"away","via":"seacombe-house1"},{"id":"will","role":"Field hand","wander":[464.0,1104.0,656.0,1264.0],"chore":"hoe","says":["Weeds come up quicker than the pumpkins. Every morning, same fight.","Biggest pumpkin at the harvest fair takes a barrel of ale. This year it's mine."],"night":"away","via":"seacombe-farmhouse"},{"id":"ned","role":"Field hand","wander":[848.0,1104.0,1104.0,1264.0],"chore":"dig","says":"Corn's nearly over my head. When it tops the scarecrow, we pick.","night":"away","via":"seacombe-cottage"},{"id":"jory","role":"Farm lad","wander":[400.0,688.0,1200.0,742.4],"says":["Carrying for Master Harrow. Carrots to the stall, empty basket back. All day.","Is it true there's wolves on the river road? Real ones?"],"night":"away","via":"seacombe-croft"},{"id":"ada","role":"Gardener","wander":[1008.0,528.0,1168.0,624.0],"chore":"water","says":"Peppers want sun and a drink twice a day. Like my husband, only quieter.","night_says":["The peppers are asleep. I'm not, as it happens.","Don't look at me like that. Well... maybe a little longer."],"night":"away","via":"seacombe-house1"},{"id":"old_hob","role":"Village elder","post":[774.4,633.6],"facing":"down","chore":"sit","says":["Sixty harvests I've seen from this bench. Never a bad one till the brook went quiet.","A combe's a valley, and ours is a tight one: fells at our backs, the sea at our feet. Room for fields and not much else."],"night":"away","via":"seacombe-cottage"},{"id":"nell","role":"Dairymaid","post":[307.2,1075.2],"facing":"down","chore":"sit","says":"Five minutes off my feet. The cows don't care that it's a feast day.","night_says":["Off my feet at last, and here you are. Perfect timing.","Stay for supper? There's stew, and I don't bite. Much."],"night":"away","via":"seacombe-farmhouse"},{"id":"seedsman","role":"Seedsman","post":[320.0,432.0],"facing":"down","says":["Shut, I'm afraid. The seed cart went to Riverhold a fortnight back and hasn't come home.","No seed, no feed. Come back when the cart does. If it does."],"night":"away","via":"seacombe-croft"},{"id":"barnhand","role":"Barn hand","post":[172.8,1075.2],"facing":"down","says":"Hay's in, thank the gods. Rain's coming, my knee says so.","night":"away","via":"seacombe-farmhouse"},{"id":"meg","role":"Villager","wander":[464.0,496.0,880.0,678.4],"says":["Fresh water from the well's sweeter than the brook. Help yourself.","My Will's out in the pumpkins. He talks to them, you know."],"night_says":["I was just dreaming of someone, and now here you are.","Make a wish on the first star with me. I'll tell you mine if you tell me yours."],"night":"away","via":"seacombe-cottage"},{"id":"hal","role":"Crofter","wander":[1520.0,1072.0,1744.0,1232.0],"chore":"hoe","says":["First field cut, two to go. The wheat'll want another fortnight.","Mind the brook if you cross at dusk. It's deeper than it looks."],"night":"away","via":"seacombe-croft"}],"facing":"right","breaks":[{"thing":380,"kind":"crate","solid":[[511,609,538,627]]},{"thing":381,"kind":"crate","solid":[[549,615,576,633]]},{"thing":382,"kind":"crate","solid":[[588,609,615,627]]}],"shut":[{"rect":[268,416,40,18],"says":"The door is barred."},{"rect":[124,1056,40,18],"says":"The big doors are shut fast."},{"rect":[252,1056,40,18],"says":"The big doors are shut fast."}],"lights":[[208,360,"window"],[368,360,"window"],[560,360,"window"],[848,339,"window"],[1062,360,"window"],[1612,264,"window"]]}