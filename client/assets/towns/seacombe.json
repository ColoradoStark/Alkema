2],[90,62,959,1004],[91,100,1158,1203],[90,209,1286,1331],[92,268,915,979],[93,280,1149,1171],[94,246,946,985],[86,27,-39,51],[86,75,47,137],[86,123,-39,51],[86,171,47,137],[86,219,-39,51],[86,267,47,137],[88,-18,97,214],[87,-13,150,307],[95,212,601,665],[96,58,416,608]],"arrive":[96,704],"exits":[{"rect":[0,640,64,128],"to":null,"dir":"left"},{"rect":[946,416,28,18],"to":"seacombe-farmhouse","at":[368,492],"dir":"up","door":true},{"rect":[1154,448,28,18],"to":"seacombe-cottage","at":[304,492],"dir":"up","door":true},{"rect":[1330,416,28,18],"to":"seacombe-house1","at":[304,492],"dir":"up","door":true},{"rect":[1890,320,28,18],"to":"seacombe-croft","at":[304,492],"dir":"up","door":true},{"rect":[146,608,28,18],"to":"seacombe-healer","at":[272,364],"dir":"up","door":true}],"indoors":false,"folk":[{"id":"tom","role":"Farmer","wander":[784.0,848.0,976.0,976.0],"chore":"water","says":["Carrots want a good soak before the sun's up. Beets too.","Every bed you see here my grandfather dug. I just keep them wet."],"night":"away","via":"seacombe-house1"},{"id":"maud","role":"Farmer's wife","wander":[1168.0,848.0,1424.0,976.0],"chore":"water","says":["The potatoes are only just up. Mind where you put your feet.","If you're bound for Riverhold, they pay better for our onions than the grocer lets on."],"night":"away","via":"seacombe-house1"},{"id":"will","role":"Field hand","wander":[784.0,1104.0,976.0,1264.0],"chore":"hoe","says":["Weeds come up quicker than the pumpkins. Every morning, same fight.","Biggest pumpkin at the harvest fair takes a barrel of ale. This year it's mine."],"night":"away","via":"seacombe-farmhouse"},{"id":"ned","role":"Field hand","wander":[1168.0,1104.0,1424.0,1264.0],"chore":"dig","says":"Corn's nearly over my head. When it tops the scarecrow, we pick.","night":"away","via":"seacombe-cottage"},{"id":"jory","role":"Farm lad","wander":[720.0,688.0,1520.0,742.4],"says":["Carrying for Master Harrow. Carrots to the stall, empty basket back. All day.","Is it true there's wolves on the river road? Real ones?"],"night":"away","via":"seacombe-croft"},{"id":"ada","role":"Gardener","wander":[1328.0,528.0,1488.0,624.0],"chore":"water","says":"Peppers want sun and a drink twice a day. Like my husband, only quieter.","night_says":["The peppers are asleep. I'm not, as it happens.","Don't look at me like that. Well... maybe a little longer."],"night":"away","via":"seacombe-house1"},{"id":"old_hob","role":"Village elder","post":[1094.4,633.6],"facing":"down","chore":"sit","says":["Sixty harvests I've seen from this bench. Never a bad one till the brook went quiet.","A combe's a valley, and ours is a tight one: fells at our backs, the sea at our feet. Room for fields and not much else."],"night":"away","via":"seacombe-cottage"},{"id":"nell","role":"Dairymaid","post":[627.2,1075.2],"facing":"down","chore":"sit","says":"Five minutes off my feet. The cows don't care that it's a feast day.","night_says":["Off my feet at last, and here you are. Perfect timing.","Stay for supper? There's stew, and I don't bite. Much."],"night":"away","via":"seacombe-farmhouse"},{"id":"seedsman","role":"Seedsman","post":[640.0,432.0],"facing":"down","says":["Shut, I'm afraid. The seed cart went to Riverhold a fortnight back and hasn't come home.","No seed, no feed. Come back when the cart does. If it does."],"night":"away","via":"seacombe-croft"},{"id":"barnhand","role":"Barn hand","post":[492.8,1075.2],"facing":"down","says":"Hay's in, thank the gods. Rain's coming, my knee says so.","night":"away","via":"seacombe-farmhouse"},{"id":"meg","role":"Villager","wander":[784.0,496.0,1200.0,678.4],"says":["Fresh water from the well's sweeter than the brook. Help yourself.","My Will's out in the pumpkins. He talks to them, you know."],"night_says":["I was just dreaming of someone, and now here you are.","Make a wish on the first star with me. I'll tell you mine if you tell me yours."],"night":"away","via":"seacombe-cottage"},{"id":"hal","role":"Crofter","wander":[1840.0,1072.0,2064.0,1232.0],"chore":"hoe","says":["First field cut, two to go. The wheat'll want another fortnight.","Mind the brook if you cross at dusk. It's deeper than it looks."],"night":"away","via":"seacombe-croft"}],"facing":"right","breaks":[{"thing":380,"kind":"crate","solid":[[831,609,858,627]]},{"thing":381,"kind":"crate","solid":[[869,615,896,633]]},{"thing":382,"kind":"crate","solid":[[908,609,935,627]]},{"thing":452,"kind":"crate","solid":[[272,957,329,979]]},{"thing":453,"kind":"barrel","solid":[[281,1149,307,1171]]},{"thing":454,"kind":"crate","solid":[[248,967,275,985]]}],"shut":[{"rect":[588,416,40,18],"says":"The door is barred."},{"rect":[444,1056,40,18],"says":"The big doors are shut fast."},{"rect":[572,1056,40,18],"says":"The big doors are shut fast."}],"lights":[[528,360,"window"],[688,360,"window"],[880,360,"window"],[1168,339,"window"],[1382,360,"window"],[1932,264,"window"],[102,552,"window"],[217,552,"window"]]}