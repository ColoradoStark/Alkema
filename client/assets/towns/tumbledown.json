rect":[642,1056,28,18],"to":"tumbledown-house3","at":[336,492],"dir":"up","door":true},{"rect":[1266,1056,28,18],"to":"tumbledown-house4","at":[336,492],"dir":"up","door":true},{"rect":[1810,1056,28,18],"to":"tumbledown-trapper","at":[304,492],"dir":"up","door":true},{"rect":[130,704,28,18],"to":"tumbledown-healer","at":[272,364],"dir":"up","door":true}],"indoors":false,"folk":[{"id":"sven","role":"Woodcutter","post":[1523.2,723.2],"facing":"left","chore":"chop","says":["Every log I split now is one less shiver come midwinter.","Mind the pines when the wind's up. They drop their snow on your head and laugh about it."],"night":"away","via":"tumbledown-longhall"},{"id":"bjorn","role":"Woodcutter","post":[1190.4,684.8],"facing":"right","chore":"chop","says":["White since I was twenty. The cold gets into your hair up here, they say.","Sven's my brother. He chops, I chop. Nobody in Tumbledown ever died of too much firewood."],"night":"away","via":"tumbledown-longhall"},{"id":"astrid","role":"Ice fisher","post":[832.0,1427.2],"facing":"down","chore":"fish","says":["Cut the hole, drop the line, wait. Then wait. Then go home cold.","The ice is thick this close in. Out past the edge it's black water all the way to Ravenford."],"night":"away","via":"tumbledown-longhall"},{"id":"haldor","role":"Ice fisher","post":[1056.0,1459.2],"facing":"down","chore":"fish","says":["Sixty winters on this ice. It's never let me through yet. Touch wood.","When the lights burn green over Nightspire, the fish go deep. They know."],"night":"away","via":"tumbledown-longhall"},{"id":"liv","role":"Ice fisher","post":[1280.0,1427.2],"facing":"down","chore":"fish","says":["Shh. Grandad says talk quietly on the ice. So come closer, and whisper.","Three herring and a boot today. And now you. My luck's turning."],"night_says":["No fish bite at night. I might, if you stand that close.","My hands are cold from the ice. Will you warm them for me?"],"night":"away","via":"tumbledown-longhall"},{"id":"eirik","role":"Snow-clearer","wander":[144.0,752.0,1936.0,816.0],"chore":"dig","says":["Clear the road at dawn, it's snowed under by noon. Clear it again. That's the job.","Came up the coast road, did you? It's the only way in that the snow doesn't close."],"night":"away","via":"tumbledown-longhall"},{"id":"ingeborg","role":"Snow-clearer","wander":[592.0,976.0,1168.0,1168.0],"chore":"dig","says":"Path to the well, path to the shore, path to the longhall. Mostly the longhall.","night":"away","via":"tumbledown-longhall"},{"id":"torvald","role":"Village elder","post":[716.8,716.8],"facing":"down","chore":"sit","says":["Tumbledown. There was a watchtower on the point once. It fell in the great storm, so here we are.","South across the ice is Ravenford. Grim folk. Good furs, though.","Nightspire? We don't say that name after dark. You shouldn't either."],"night":"away","via":"tumbledown-house3"},{"id":"kari","role":"Kindling gatherer","wander":[144.0,368.0,2000.0,432.0],"says":["Pine cones burn hot and quick. A bit like me, some say.","Carry my basket home for me? I'll make it worth your while."],"night_says":["The fire's roaring now. All that kindling, and it's just for us.","It's freezing out there. Good thing I'm warm in here, isn't it?"],"night":"away","via":"tumbledown-longhall"},{"id":"rune","role":"Village lad","wander":[656.0,816.0,1552.0,1008.0],"says":["Bet you've never seen ice you can walk on. Go on, it holds. Mostly.","Old Haldor says there's a whale under the ice. I've never seen it. Yet."],"night":"away","via":"tumbledown-house4"},{"id":"signe","role":"Net-mender","post":[908.8,1273.6],"facing":"down","chore":"sit","says":["The ice tears nets like paper. So I mend, and Astrid tears them again.","Haldor's my father. Don't let him tell you about the whale."],"night":"away","via":"tumbledown-longhall"},{"id":"arne","role":"Fisherman","post":[652.8,1376.0],"facing":"down","chore":"fish","says":["Boats wait for the thaw. I don't. A line through the ice catches the same fish.","Herring for the smokehouse, cod for the pot, and the odd trout when the gods are kind."],"night":"away","via":"tumbledown-longhall"},{"id":"gunnhild","role":"Fishwife","wander":[720.0,1168.0,1424.0,1296.0],"says":"Herring up to the smokehouse, a basket at a time. My arms are twice the size of Arne's.","night":"away","via":"tumbledown-house2"},{"id":"leif","role":"Hunter","post":[1920.0,1068.8],"facing":"left","says":["Fox and hare this winter. Wolves in the deep wood, but I leave them be.","West through the pines there's a hole in the hill they call Shadowmaw. My dogs won't go near it."],"night":"away","via":"tumbledown-longhall"},{"id":"tove","role":"Villager","wander":[1232.0,784.0,1936.0,1072.0],"says":["White hair since birth. Mother says the snow got in. Do you like it?","If my brother offers you a fox pelt, haggle. If I offer you a kiss, don't."],"night_says":["The snow's falling again. Looks like you'll have to stay the night.","Pull the furs up close. There's room under them for two."],"night":"away","via":"tumbledown-house1"},{"id":"halvard","role":"Watchman","post":[147.2,844.8],"facing":"right","says":["A traveller, this far north? Welcome to Tumbledown. Fire's lit in the Longhall.","I watch the road. Snow mostly. Once a bear. The bear was more polite than most."]}],"facing":"right","breaks":[{"thing":21,"kind":"crate","solid":[[984,718,1011,736]]},{"thing":22,"kind":"crate","solid":[[1170,718,1198,736]]},{"thing":23,"kind":"barrel","solid":[[951,573,994,595]]},{"thing":36,"kind":"crate","solid":[[1183,1268,1210,1286]]},{"thing":37,"kind":"crate","solid":[[1228,1294,1255,1312]]},{"thing":38,"kind":"barrel","solid":[[825,1270,851,1292]]},{"thing":39,"kind":"crate","solid":[[1321,1296,1379,1318]]}],"shut":[{"rect":[1516,1248,40,18],"says":"The big doors are shut fast."}],"lights":[[672,616,"window"],[864,616,"window"],[665,688,"torch"],[838,688,"torch"],[976,1200,"campfire"],[416,616,"window"],[1472,616,"window"],[1712,616,"window"],[320,1000,"window"],[592,1000,"window"],[704,1000,"window"],[1360,1000,"window"],[192,648,"window"]],"snow":true}